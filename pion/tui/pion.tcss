Screen {
    layers: base scrim drawer overlay;
    layout: vertical;
    background: $pion-bg;
    color: $pion-text;
}

/* Application chrome */

#app-header {
    height: 1;
    padding: 0 2;
    background: $pion-surface;
}

#header-summary {
    width: 1fr;
    height: 1;
    color: $pion-text;
    text-overflow: ellipsis;
}

#header-status {
    width: auto;
    min-width: 20;
    color: $pion-success;
    text-align: right;
}

#header-status.running {
    color: $pion-accent;
}

#workspace {
    height: 1fr;
    background: $pion-bg;
}

/* Session drawer */

#tree-scrim {
    display: none;
    layer: scrim;
    dock: top;
    width: 100%;
    height: 100%;
    background: $pion-bg 72%;
}

#tree-scrim.-shown {
    display: block;
}

#session-tree {
    display: none;
    layer: drawer;
    dock: left;
    width: 30;
    min-width: 26;
    max-width: 32;
    height: 100%;
    background: $pion-surface;
    border-right: solid $pion-border;
}

#session-tree.-shown {
    display: block;
}

#tree-header {
    height: 4;
    padding: 1 1 0 2;
    border-bottom: solid $pion-border;
}

#tree-title-row {
    height: 1;
}

#tree-footer {
    height: 4;
    padding: 0 1 0 2;
    border-top: solid $pion-border;
}

#tree-title {
    width: 1fr;
    color: $pion-muted;
    text-style: bold;
}

#tree-count {
    width: auto;
    color: $pion-faint;
    text-align: right;
}

#tree-session {
    height: 1;
    color: $pion-faint;
    text-overflow: ellipsis;
}

#session-tree-widget {
    height: 1fr;
    padding: 0 1;
    background: $pion-surface;
    color: $pion-muted;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $pion-surface;
    scrollbar-color: $pion-border;
    scrollbar-color-hover: $pion-muted;
    scrollbar-color-active: $pion-accent;
}

#session-tree-widget > .tree--cursor {
    background: $pion-hover;
    color: $pion-text;
    text-style: none;
}

#session-tree-widget > .tree--highlight,
#session-tree-widget > .tree--highlight-line {
    background: $pion-hover;
}

#session-tree-widget > .tree--guides,
#session-tree-widget > .tree--guides-hover,
#session-tree-widget > .tree--guides-selected {
    color: $pion-border;
}

#tree-filter-row {
    height: 1;
}

#tree-filter {
    width: 1fr;
    color: $pion-accent;
}

#tree-filter-hint {
    width: auto;
    color: $pion-faint;
    text-align: right;
}

#tree-help {
    height: 2;
    color: $pion-faint;
}

/* Conversation */

#main-pane {
    width: 1fr;
    height: 1fr;
    background: $pion-bg;
}

#conversation {
    height: 1fr;
    padding: 1 3 0 3;
    background: $pion-bg;
    align-horizontal: center;
    scrollbar-size: 1 1;
    scrollbar-background: $pion-bg;
    scrollbar-color: $pion-border;
    scrollbar-color-hover: $pion-muted;
    scrollbar-color-active: $pion-accent;
}

#conversation-stream {
    width: 100%;
    max-width: 112;
    height: auto;
}

.chat-message {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.user-message {
    padding: 0 1;
    background: $pion-panel;
}

.assistant-message {
    padding: 0 1;
}

.message-glyph {
    width: 3;
    height: 1;
    color: $pion-accent;
    text-style: bold;
}

.assistant-glyph {
    color: $pion-accent;
}

.message-body {
    width: 1fr;
    height: auto;
}

.message-markdown {
    width: 100%;
    height: auto;
    padding: 0;
    margin: 0;
    color: $pion-text;
    background: transparent;
    overflow-x: hidden;
}

.message-markdown MarkdownParagraph {
    margin: 0 0 1 0;
}

.user-message .message-markdown MarkdownParagraph:last-child,
.assistant-message .message-markdown MarkdownParagraph:last-child {
    margin-bottom: 0;
}

.message-markdown MarkdownHeader,
.message-markdown MarkdownH1,
.message-markdown MarkdownH2,
.message-markdown MarkdownH3,
.message-markdown MarkdownH4,
.message-markdown MarkdownH5,
.message-markdown MarkdownH6 {
    color: $pion-text;
    background: transparent;
    text-style: bold;
    content-align: left middle;
    margin: 1 0 0 0;
}

.message-markdown MarkdownBlockQuote {
    margin: 1 0;
    padding: 0 1;
    background: $pion-panel;
    border-left: solid $pion-border;
}

.message-markdown MarkdownFence {
    width: 100%;
    margin: 1 0;
    padding: 0;
    background: $pion-panel;
    border-left: solid $pion-border;
    overflow: hidden hidden;
}

.message-markdown MarkdownFence > Label {
    width: 100%;
    padding: 1 2;
}

.message-markdown MarkdownTable {
    width: 100%;
    margin: 1 0;
    background: $pion-panel;
    border: solid $pion-border;
    overflow-x: hidden;
}

.message-markdown MarkdownBlock > .code_inline {
    background: $pion-hover;
    color: $pion-text;
}

.thinking-panel {
    height: auto;
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
    color: $pion-muted;
}

.thinking-panel.empty {
    display: none;
}

.thinking-panel:focus-within {
    background: $pion-panel;
    background-tint: transparent;
}

.thinking-panel > CollapsibleTitle {
    height: 1;
    padding: 0;
    color: $pion-muted;
    background: transparent;
}

.thinking-panel > Contents {
    height: auto;
    padding: 1 2;
    margin-top: 0;
    background: $pion-panel;
    border-left: solid $pion-border;
}

.thinking-content {
    height: auto;
    max-height: 18;
    overflow-y: auto;
    color: $pion-muted;
}

/* Tool activity */

.tool-card {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0;
    background: transparent;
    border: none;
    color: $pion-success;
}

.tool-card.error {
    color: $pion-error;
}

.tool-card:focus-within {
    background: $pion-hover;
    background-tint: transparent;
}

.tool-card > CollapsibleTitle {
    height: 1;
    padding: 0 1 0 4;
    color: $pion-muted;
    background: transparent;
}

.tool-card.error > CollapsibleTitle {
    color: $pion-error;
}

.tool-card > Contents {
    height: auto;
    padding: 1 2;
    margin-top: 1;
    background: $pion-panel;
    border-left: solid $pion-border;
}

.tool-details {
    height: auto;
    max-height: 20;
    overflow-y: auto;
    color: $pion-muted;
    scrollbar-size: 1 1;
    scrollbar-background: $pion-panel;
    scrollbar-color: $pion-border;
}

/* Empty conversation */

#empty-state {
    width: 100%;
    height: 1fr;
    min-height: 8;
    padding: 2 4;
    align: center middle;
}

.empty-brand {
    width: auto;
    height: 1;
    color: $pion-accent;
    text-style: bold;
    text-align: center;
}

.empty-project {
    width: auto;
    height: 1;
    color: $pion-muted;
    text-align: center;
}

.empty-path {
    width: 80%;
    height: 1;
    color: $pion-faint;
    text-align: center;
    text-overflow: ellipsis;
}

.empty-help {
    width: auto;
    height: 1;
    margin-top: 1;
    color: $pion-muted;
    text-align: center;
}

/* Prompt composer */

#composer {
    width: 1fr;
    height: 3;
    min-height: 3;
    max-height: 8;
    margin: 1 2 1 2;
    background: $pion-surface;
    border: round $pion-border;
}

#composer:focus-within {
    border: round $pion-muted;
}

#composer.running {
    opacity: 65%;
    border: round $pion-border;
}

#composer-input {
    width: 100%;
    height: 1fr;
}

#composer-prompt {
    width: 3;
    height: 1;
    padding-left: 1;
    color: $pion-faint;
    text-style: bold;
}

#composer-hint {
    width: 12;
    height: 1;
    padding-right: 1;
    color: $pion-faint;
    text-align: right;
}

#composer.running #composer-hint {
    color: $pion-warning;
}

#composer:focus-within #composer-prompt {
    color: $pion-accent;
}

#prompt-editor {
    width: 1fr;
    height: 1;
    min-height: 1;
    max-height: 6;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $pion-text;
    scrollbar-size: 1 1;
    scrollbar-background: $pion-surface;
    scrollbar-color: $pion-border;
}

#prompt-editor:focus {
    border: none;
}

#prompt-editor > .text-area--cursor-line,
#prompt-editor > .text-area--gutter,
#prompt-editor > .text-area--cursor-gutter {
    background: transparent;
}

#prompt-editor > .text-area--cursor {
    background: $pion-accent;
    color: $pion-bg;
    text-style: none;
}

#prompt-editor > .text-area--selection {
    background: $pion-accent-dim;
}

#prompt-editor > .text-area--placeholder {
    color: $pion-faint;
}

/* Modals and shared controls */

ModalScreen {
    align: center middle;
    background: $pion-bg 75%;
}

.modal-box {
    width: 68;
    max-width: 92%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $pion-border;
    background: $pion-panel;
}

.compact-modal {
    width: 64;
}

.choice-modal {
    width: 68;
    height: 22;
}

.modal-title {
    height: 2;
    color: $pion-text;
    text-style: bold;
}

.modal-actions {
    height: 3;
    margin-top: 1;
    align-horizontal: right;
}

.modal-actions Button {
    min-width: 12;
    margin-left: 1;
    border: none;
    background: $pion-hover;
    color: $pion-text;
}

.modal-actions Button:hover,
.modal-actions Button:focus {
    background: $pion-border;
    color: $pion-text;
    text-style: bold;
}

.modal-actions Button.-primary {
    background: $pion-accent;
    color: $pion-bg;
}

.modal-hint {
    height: 1;
    color: $pion-faint;
}

Input {
    border: tall $pion-border;
    background: $pion-surface;
    color: $pion-text;
}

Input:focus {
    border: tall $pion-accent;
}

OptionList {
    background: $pion-panel;
    color: $pion-muted;
    border: none;
    scrollbar-size: 1 1;
    scrollbar-background: $pion-panel;
    scrollbar-color: $pion-border;
}

OptionList > .option-list--option-highlighted {
    background: $pion-hover;
    color: $pion-text;
    text-style: bold;
}

OptionList > .option-list--option-hover {
    background: $pion-hover;
    color: $pion-text;
}

ToastRack {
    padding: 1 2;
}

Toast {
    border: round $pion-border;
    background: $pion-panel;
    color: $pion-text;
}

/* Responsive compact chrome */

.narrow #session-tree.-shown {
    width: 85%;
    max-width: 32;
    min-width: 24;
}

.narrow #app-header,
.narrow #conversation {
    padding: 1 1 0 1;
}

.narrow #app-header {
    padding: 0 1;
}

.narrow #composer {
    margin: 1 1;
}

.narrow #composer-hint {
    display: none;
}
